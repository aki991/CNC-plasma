{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "strict": true,
    "allowSyntheticDefaultImports": true, "esModuleInterop": true,
    "jsx": "react-jsx", "noEmit": true, "skipLibCheck": true,
    "types": ["vite/client", "node"]
  },
  "include": ["src", "scripts", "tests", "*.ts"]
}
